[Unit]
Description=Sistema Inventario Pollos Lucho
After=network.target mysql.service
Wants=mysql.service

[Service]
User=pollos
Group=pollos
WorkingDirectory=/opt/pollos-lucho
ExecStart=/opt/pollos-lucho/venv/bin/gunicorn -c gunicorn.conf.py "app:create_app()"
Restart=on-failure
RestartSec=5
Environment=HOME=/opt/pollos-lucho
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TZ=America/La_Paz

[Install]
WantedBy=multi-user.target